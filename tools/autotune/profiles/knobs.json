{
  "schema": "dgx-knobs/v1",
  "source": "runtime/knobs.h",
  "prefixes": ["G4_", "BENCH_G4_", "GEMV_", "MMQ", "DRAFT_", "MTP_", "MOE_", "DGX_"],
  "knobs": [
    {"name": "G4_ATTN_SPLIT", "type": "enum", "default": "1", "range": "0|1", "class": "numeric",
     "scope": "gemma4 dense decode/verify/batch attention", "gates": "golden, ppl, spec==greedy, batch==single, fastpath==batch, graph_on==off", "desc": "1 = split-KV decode attention (R15 default); 0 = per-query-head kernels and fp32 KV default",
     "choices": ["0", "1"]},
    {"name": "G4_ATTN_CHUNK", "type": "enum", "default": "64", "range": "32|64|128|256", "class": "numeric",
     "scope": "gemma4 split-KV attention", "gates": "golden, ppl, spec==greedy, batch==single, fastpath==batch, graph_on==off", "desc": "split-KV chunk length in keys (changes the combine order)",
     "choices": ["32", "64", "128", "256"]},
    {"name": "G4_KV_DTYPE", "type": "enum", "default": "f16", "range": "fp32|f16|bf16", "class": "numeric",
     "scope": "gemma4 dense KV storage (MoE forces fp32)", "gates": "golden, ppl, spec==greedy, batch==single, fastpath==batch, graph_on==off", "desc": "KV cache element type; unset = f16, or fp32 when G4_ATTN_SPLIT=0",
     "choices": ["fp32", "f16", "bf16"]},
    {"name": "G4_MMQ_PREFILL", "type": "enum", "default": "1", "range": "0|1", "class": "numeric",
     "scope": "gemma4 prefill linear layers (W4A8)", "gates": "golden, ppl, prefill_slot", "desc": "1 = MMQ tensor-core prefill GEMM for S >= G4_MMQ_MIN_S; 0 = SB/GEMV prefill",
     "choices": ["0", "1"]},
    {"name": "G4_MMQ_MIN_S", "type": "int", "default": "16", "range": "16..", "class": "numeric",
     "scope": "gemma4 prefill linear layers", "gates": "golden, ppl, prefill_slot", "desc": "smallest prefill row count that uses MMQ (values below 16 were clamped to 16 before v1)"},
    {"name": "G4_FLASH_PREFILL", "type": "enum", "default": "1", "range": "0|1", "class": "numeric",
     "scope": "gemma4 prefill attention", "gates": "golden, ppl, prefill_slot", "desc": "1 = tensor-core flash attention for prefill chunks with S >= G4_FLASH_MIN_S",
     "choices": ["0", "1"]},
    {"name": "G4_FLASH_MIN_S", "type": "int", "default": "16", "range": "16..", "class": "numeric",
     "scope": "gemma4 prefill attention", "gates": "golden, ppl, prefill_slot", "desc": "smallest prefill row count that uses flash attention"},
    {"name": "G4_NORM_FUSED", "type": "enum", "default": "1", "range": "0|1", "class": "numeric",
     "scope": "gemma4 dense decode/verify/batch/concat/prefill norms", "gates": "golden, ppl, spec==greedy, batch==single, fastpath==batch, graph_on==off", "desc": "parallel RMSNorm row function + q/k norm+RoPE(+KV store) and post-norm+residual fusions (R16 default); 0 = per-kernel norms",
     "choices": ["0", "1"]},
    {"name": "G4_CUDA_GRAPH", "type": "enum", "default": "2", "range": "0|1|2", "class": "tunable",
     "scope": "gemma4 single-stream decode (generate session, gemma4_decode)", "gates": "graph_on==off, fastpath==batch", "desc": "decode launch mode: unset/2 = Graph v2 session, 1 = per-step v1 capture, 0 = eager",
     "choices": ["0", "1", "2"]},
    {"name": "G4_GRAPH_OVERLAP", "type": "enum", "default": "1", "range": "0|1", "class": "tunable",
     "scope": "gemma4 Graph v2 session", "gates": "graph_on==off", "desc": "overlap host bookkeeping with the next replay (v2 only)",
     "choices": ["0", "1"]},
    {"name": "G4_GRAPH_NODE_UPDATE", "type": "enum", "default": "0", "range": "0|1", "class": "tunable",
     "scope": "gemma4 Graph v2 session", "gates": "graph_on==off", "desc": "direct kernel-node parameter patching instead of per-step capture + exec update (v2 only)",
     "choices": ["0", "1"]},
    {"name": "G4_SERVE_FASTPATH", "type": "enum", "default": "1", "range": "0|1", "class": "tunable",
     "scope": "online daemon, single-stream backends", "gates": "fastpath==batch", "desc": "serve a lone greedy request through the Graph v2 generation session",
     "choices": ["0", "1"]},
    {"name": "BM16", "type": "enum", "default": "0", "range": "0|1", "class": "numeric",
     "scope": "gemma4/qwen batch decode B >= 14", "gates": "golden, ppl, batch==single", "desc": "opt-in BM16 split-K GEMM for large batches (scheme change)",
     "choices": ["0", "1"]},
    {"name": "SPLITK", "type": "int", "default": "0", "range": "0..", "class": "numeric",
     "scope": "BM16 split-K GEMM (only with BM16=1)", "gates": "golden, ppl, batch==single", "desc": "split-K factor; 0 = automatic (about 96 blocks)"},
    {"name": "MMQ256", "type": "enum", "default": "0", "range": "0|1|2", "class": "tunable",
     "scope": "MMQ prefill/verify GEMM tile (gemma4, qwen)", "gates": "golden (claimed bitwise: same K-reduction order)", "desc": "MMQ tile: 0 = 128x128, 1 = 256x64, 2 = per-(N,K) table",
     "choices": ["0", "1", "2"]},
    {"name": "MLP_U", "type": "enum", "default": "2", "range": "2|3|4|6", "class": "tunable",
     "scope": "qwen W4A8 MLP GEMV", "gates": "golden (claimed bitwise: same compute order)", "desc": "MLP GEMV unroll factor",
     "choices": ["2", "3", "4", "6"]},
    {"name": "MOE_FUSED", "type": "enum", "default": "1", "range": "0|1", "class": "tunable",
     "scope": "MoE block (qwen 35B-A3B, gemma4 26B-A4B)", "gates": "golden, batch==single (claimed bit-identical k-order)", "desc": "1 = device-fused grouped expert GEMV; 0 = naive host loop",
     "choices": ["0", "1"]},
    {"name": "MTP_Q4", "type": "enum", "default": "0", "range": "0|1", "class": "tunable",
     "scope": "qwen MTP draft head", "gates": "spec==greedy (draft only changes proposals)", "desc": "q4 MTP draft weights",
     "choices": ["0", "1"]},
    {"name": "DRAFT_GEMV", "type": "enum", "default": "0", "range": "0|1", "class": "tunable",
     "scope": "qwen draft matmul", "gates": "spec==greedy", "desc": "GEMV draft matmul instead of gemm_batch",
     "choices": ["0", "1"]},
    {"name": "DRAFT_SEQ", "type": "enum", "default": "0", "range": "0|1", "class": "tunable",
     "scope": "qwen draft scheduling", "gates": "spec==greedy", "desc": "sequential per-slot draft",
     "choices": ["0", "1"]},
    {"name": "DRAFT_MW", "type": "enum", "default": "0", "range": "0|1|2", "class": "tunable",
     "scope": "qwen draft q4 matmul tile", "gates": "spec==greedy", "desc": "draft multi-warp tile variant (1 = NW4x2 rows, 2 = NW2x4 rows)",
     "choices": ["0", "1", "2"]},
    {"name": "DQ4", "type": "enum", "default": "", "range": "0|1", "class": "tunable",
     "scope": "qwen draft lm_head", "gates": "spec==greedy", "desc": "draft lm_head in q4; unset = on when uq != 0",
     "choices": ["0", "1"]},
    {"name": "HOTSWITCH", "type": "string", "default": "", "range": "K1,W1,K2,W2,thr", "class": "numeric",
     "scope": "qwen spec serving", "gates": "per-request ISO is not preserved (autotune-harness STEP A')", "desc": "cycle-level K/W switch on batch occupancy"},
    {"name": "PMAX", "type": "int", "default": "32", "range": "1..", "class": "numeric",
     "scope": "qwen serving prefill chunk", "gates": "golden, batch==single", "desc": "max prefill chunk length in the serving benches/daemon"},
    {"name": "STOP_IDS", "type": "int_list", "default": "", "range": "comma-separated token ids", "class": "fixed",
     "scope": "online daemons", "gates": "-", "desc": "end-of-generation token ids (model generation_config)"},
    {"name": "REP_WINDOW", "type": "int", "default": "128", "range": "0..", "class": "fixed",
     "scope": "online daemon sampling", "gates": "-", "desc": "repetition-penalty window (tokens)"},
    {"name": "DGX_LOG_INPUT_IDS", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "online daemon", "gates": "-", "desc": "log request input ids to stderr",
     "choices": ["0", "1"]},
    {"name": "DGX_KNOBS_FILE", "type": "string", "default": "", "range": "path", "class": "fixed",
     "scope": "all binaries", "gates": "-", "desc": "recipe knob file (NAME=VALUE lines), below env in priority"},
    {"name": "G4_CUDA_GRAPH_STATS", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "gemma4 graph", "gates": "-", "desc": "print graph replay/update counters",
     "choices": ["0", "1"]},
    {"name": "G4_KV_STATS", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "gemma4 16-bit KV store", "gates": "-", "desc": "count non-finite / overflowing KV stores, print at exit",
     "choices": ["0", "1"]},
    {"name": "G4_ATTN_DIAG_REVERSE", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "gemma4 per-query-head decode attention", "gates": "-", "desc": "reverse output accumulation order (quality noise baseline)",
     "choices": ["0", "1"]},
    {"name": "DBG0", "type": "string", "default": "", "range": "directory", "class": "diagnostic",
     "scope": "qwen layer-0 GDN", "gates": "-", "desc": "dump layer-0 intermediates"},
    {"name": "BENCH_G4_PREFILL_MIN_SEC", "type": "float", "default": "", "range": "0..", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "repeat prefill until this many seconds (> 0)"},
    {"name": "BENCH_G4_DECODE_INPUT", "type": "enum", "default": "fixed", "range": "fixed|greedy", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "single-decode input tokens",
     "choices": ["fixed", "greedy"]},
    {"name": "BENCH_G4_DEPTH", "type": "int", "default": "0", "range": "0..", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "starting n_past for single decode"},
    {"name": "BENCH_G4_SINGLE_UQ", "type": "enum", "default": "0", "range": "0|1|2", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "single-decode precision (0 = both)",
     "choices": ["0", "1", "2"]},
    {"name": "BENCH_G4_DECODE_INTERVAL", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "print decode interval epochs",
     "choices": ["0", "1"]},
    {"name": "BENCH_G4_DUMP_LOGITS", "type": "string", "default": "", "range": "path prefix", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "dump single-decode logits"},
    {"name": "BENCH_G4_AMORT", "type": "enum", "default": "1", "range": "0|1", "class": "diagnostic",
     "scope": "bench_gemma4", "gates": "-", "desc": "amortized prefill matmul in the prefill bench",
     "choices": ["0", "1"]},
    {"name": "SKIP1TOK", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "bench_serve", "gates": "-", "desc": "skip the one-token-per-step serving mode"},
    {"name": "SKIPSTAT", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "bench_serve", "gates": "-", "desc": "skip the static-batch mode"},
    {"name": "BONLY", "type": "int", "default": "0", "range": "0..", "class": "diagnostic",
     "scope": "bench_batch", "gates": "-", "desc": "run only this batch size (0 = all)"},
    {"name": "REPS", "type": "int", "default": "1", "range": "1..", "class": "diagnostic",
     "scope": "bench_batch", "gates": "-", "desc": "timed loop repetitions (min taken)"},
    {"name": "SHORTP", "type": "float", "default": "0.7", "range": "0..1", "class": "diagnostic",
     "scope": "qwen spec bench/daemon workload", "gates": "-", "desc": "short-request ratio of the synthetic trace"},
    {"name": "TIME", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "qwen spec bench/daemon, test_batchspec2", "gates": "-", "desc": "per-phase timing",
     "choices": ["0", "1"]},
    {"name": "CYC", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "qwen spec bench/daemon", "gates": "-", "desc": "spec cycle decomposition",
     "choices": ["0", "1"]},
    {"name": "ISO", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "qwen spec bench/daemon", "gates": "-", "desc": "batched==solo token check",
     "choices": ["0", "1"]},
    {"name": "TRIALS", "type": "enum", "default": "0", "range": "0|1", "class": "diagnostic",
     "scope": "qwen spec bench/daemon", "gates": "-", "desc": "warm autotune server (stdin trials)",
     "choices": ["0", "1"]},
    {"name": "SOLO", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "serve_daemon_qwen_spec_online", "gates": "-", "desc": "canonical solo spec gate mode"},
    {"name": "ADAPT", "type": "enum", "default": "0", "range": "0|1|2", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "adaptive draft length experiment",
     "choices": ["0", "1", "2"]},
    {"name": "KMIN", "type": "int", "default": "1", "range": "..", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "adaptive draft minimum K (clamped to 1..KMAX)"},
    {"name": "KMAX", "type": "int", "default": "8", "range": "..", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "adaptive draft maximum K (clamped to 8)"},
    {"name": "TAUS", "type": "float_list", "default": "", "range": "comma-separated floats", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "adaptive draft margin thresholds"},
    {"name": "CONF_LOG", "type": "string", "default": "", "range": "path", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "draft confidence CSV"},
    {"name": "DUMP_PLAIN", "type": "string", "default": "", "range": "directory", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "dump plain trajectories"},
    {"name": "SKIP_SPEC", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "test_gemma4_spec_e2e", "gates": "-", "desc": "plain only"},
    {"name": "DUMP", "type": "string", "default": "", "range": "directory", "class": "diagnostic",
     "scope": "test_27b", "gates": "-", "desc": "dump intermediates"},
    {"name": "V27", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "test_27b", "gates": "-", "desc": "per-layer verbose"},
    {"name": "V35", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "test_35b", "gates": "-", "desc": "per-layer verbose"},
    {"name": "FULLONLY", "type": "presence", "default": "", "range": "set", "class": "diagnostic",
     "scope": "probe_chunked_prefill", "gates": "-", "desc": "only the full-prompt chunk"}
  ]
}
